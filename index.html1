<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <meta name="theme-color" content="#081321">
  <title>Snake Game — by C00lBoss</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; }
    body {
      background: #081321;
      color: #eff8ff;
      font: 15px system-ui, sans-serif;
      touch-action: none;
    }
    canvas { display: block; width: 100%; height: 100%; }
    .hud {
      position: fixed; z-index: 2; top: 14px; left: 14px; right: 14px;
      display: flex; justify-content: space-between; align-items: flex-start;
      gap: 10px; pointer-events: none;
    }
    .badge {
      padding: 10px 14px; border: 1px solid #ffffff25; border-radius: 12px;
      background: #081321d9; box-shadow: 0 8px 24px #0005;
    }
    .brand { font-weight: 900; letter-spacing: .12em; }
    .brand span { color: #a3ff6f; }
    .byline { color: #9db4c5; font-size: 10px; letter-spacing: .15em; margin-top: 3px; }
    .scores { display: flex; gap: 16px; }
    .scores small { display: block; color: #9db4c5; font-size: 9px; letter-spacing: .12em; }
    .scores b { font-size: 17px; }
    .leaders { width: 175px; }
    .leaders strong { display: block; color: #9db4c5; font-size: 10px; letter-spacing: .12em; margin-bottom: 5px; }
    .leaders ol { padding: 0; margin: 0; list-style: none; font-size: 11px; }
    .leaders li { display: flex; justify-content: space-between; padding: 2px 0; }
    .leaders .you { color: #a3ff6f; }
    .hint {
      position: fixed; z-index: 2; bottom: 12px; left: 50%; transform: translateX(-50%);
      padding: 8px 13px; border: 1px solid #ffffff25; border-radius: 20px;
      background: #081321d9; color: #b6c8d4; font-size: 11px; white-space: nowrap;
    }
    .overlay {
      position: fixed; z-index: 5; inset: 0; display: grid; place-items: center;
      padding: 18px; background: #030913a8;
    }
    .overlay.hidden { display: none; }
    .card {
      width: min(420px, 100%); padding: 30px 24px; text-align: center;
      border: 1px solid #6be6ef55; border-radius: 20px;
      background: linear-gradient(145deg, #142b3d, #091522);
      box-shadow: 0 24px 80px #0009;
    }
    .card small { color: #5ee7f7; font-weight: 800; letter-spacing: .18em; }
    h1 { margin: 12px 0; font-size: clamp(40px, 10vw, 58px); line-height: .95; }
    h1 span { color: #a3ff6f; }
    .card p { color: #b3c5d1; line-height: 1.6; }
    input {
      width: 100%; padding: 12px; margin: 8px 0 12px; border-radius: 9px;
      border: 1px solid #466176; background: #071321; color: white; font: inherit;
    }
    button {
      border: 0; border-radius: 9px; padding: 13px 20px; cursor: pointer;
      background: linear-gradient(100deg, #5ee7f7, #a3ff6f);
      color: #081321; font: 800 14px system-ui, sans-serif;
    }
    #play { width: 100%; }
    #boost {
      position: fixed; z-index: 3; right: 18px; bottom: 55px; display: none;
      width: 70px; height: 70px; border-radius: 50%;
      background: linear-gradient(145deg, #ffc14f, #ff735c);
    }
    @media (max-width: 650px) {
      .hud { top: 8px; left: 8px; right: 8px; flex-wrap: wrap; }
      .badge { padding: 8px 10px; }
      .brand { font-size: 12px; }
      .scores { gap: 10px; }
      .scores b { font-size: 14px; }
      .leaders { width: 140px; }
      .leaders ol { font-size: 10px; }
      .hint { bottom: 8px; font-size: 9px; }
      #boost { display: block; }
    }
  </style>
</head>
<body>
  <canvas id="game" aria-label="Snake arena game"></canvas>

  <div class="hud">
    <div class="badge">
      <div class="brand">SNAKE<span>CLASH</span></div>
      <div class="byline">BY C00LBOSS</div>
    </div>
    <div class="badge scores">
      <div><small>MASS</small><b id="score">0</b></div>
      <div><small>BEST</small><b id="best">0</b></div>
      <div><small>KOs</small><b id="kills">0</b></div>
    </div>
    <div class="badge leaders">
      <strong>ARENA LEADERS</strong>
      <ol id="leaders"></ol>
    </div>
  </div>

  <div class="hint">Move mouse / finger or use WASD / arrow keys · Hold Shift to boost</div>
  <button id="boost" aria-label="Hold to boost">BOOST</button>

  <div class="overlay" id="overlay">
    <div class="card">
      <small>A SNAKE ARCADE BY C00LBOSS</small>
      <h1 id="title">SNAKE<br><span>CLASH</span></h1>
      <p id="message">Eat glowing orbs, grow your snake, and outlast the rival bots. Boost to chase or escape—but boosting uses mass!</p>
      <input id="name" maxlength="14" value="Player" aria-label="Snake name">
      <button id="play">ENTER THE ARENA</button>
    </div>
  </div>

  <script>
    (() => {
      const canvas = document.querySelector("#game");
      const ctx = canvas.getContext("2d");
      const overlay = document.querySelector("#overlay");
      const playButton = document.querySelector("#play");
      const nameInput = document.querySelector("#name");
      const W = 2200, H = 1500, TAU = Math.PI * 2;
      const colors = ["#ff7373","#61b5ff","#c47aff","#ffb74d","#ff70cf","#53e0bd","#f2dc59","#8f9bff"];
      const botNames = ["Noodle","Zippy","Comet","Pickle","Mochi","Turbo","Ramen","Boba","Sizzle","Viper"];
      const keys = {};
      let width = innerWidth, height = innerHeight, dpr = 1, game = null, last = 0;
      let best = Number(localStorage.getItem("snake-clash-best") || 0);
      document.querySelector("#best").textContent = best;

      const random = (min, max) => min + Math.random() * (max - min);
      const clamp = (n, min, max) => Math.max(min, Math.min(max, n));
      const distance = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
      const angleDifference = (a, b) => Math.atan2(Math.sin(b - a), Math.cos(b - a));

      function resize() {
        dpr = Math.min(devicePixelRatio || 1, 2);
        width = innerWidth;
        height = innerHeight;
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        draw();
      }
      addEventListener("resize", resize);

      function makeSnake(name, x, y, color, player = false) {
        const angle = random(0, TAU);
        const length = player ? 14 : 10;
        const body = [];
        for (let i = 0; i < length; i++) {
          body.push({ x: x - Math.cos(angle) * i * 13, y: y - Math.sin(angle) * i * 13 });
        }
        return { name, x, y, angle, target: angle, color, player, body, mass: length * 10, speed: player ? 175 : 120, alive: true, think: 0 };
      }

      function addFood(x = random(25, W - 25), y = random(25, H - 25), color = colors[Math.floor(Math.random() * colors.length)], value = 1) {
        game.food.push({ x, y, color, value, phase: random(0, TAU) });
      }

      function startGame() {
        const player = makeSnake((nameInput.value.trim() || "Player").slice(0, 14), W / 2, H / 2, "#a3ff6f", true);
        game = { player, bots: [], food: [], camera: { x: player.x, y: player.y }, kills: 0, time: 0, state: "playing" };

        for (let i = 0; i < 10; i++) {
          const x = random(80, W - 80), y = random(80, H - 80);
          game.bots.push(makeSnake(botNames[i], x, y, colors[i % colors.length]));
        }
        for (let i = 0; i < 170; i++) addFood();

        overlay.classList.add("hidden");
        playButton.textContent = "ENTER THE ARENA";
        last = performance.now();
        requestAnimationFrame(loop);
      }

      function endGame(text) {
        if (!game || game.state !== "playing") return;
        game.state = "over";
        document.querySelector("#title").innerHTML = "RUN<br><span>OVER</span>";
        document.querySelector("#message").textContent = `${text} Mass: ${Math.floor(game.player.mass)} · KOs: ${game.kills}.`;
        playButton.textContent = "PLAY AGAIN";
        overlay.classList.remove("hidden");
      }

      function updateSnake(s, dt, isPlayer) {
        if (!s.alive) return;

        if (isPlayer) {
          let dx = 0, dy = 0;
          if (keys.ArrowUp || keys.w || keys.W) dy--;
          if (keys.ArrowDown || keys.s || keys.S) dy++;
          if (keys.ArrowLeft || keys.a || keys.A) dx--;
          if (keys.ArrowRight || keys.d || keys.D) dx++;
          if (dx || dy) s.target = Math.atan2(dy, dx);
        } else {
          s.think -= dt;
          if (s.think <= 0) {
            s.think = random(.5, 1.3);
            let nearest = null, bestDistance = Infinity;
            for (const food of game.food) {
              const d = (food.x - s.x) ** 2 + (food.y - s.y) ** 2;
              if (d < bestDistance) { bestDistance = d; nearest = food; }
            }
            if (nearest) s.target = Math.atan2(nearest.y - s.y, nearest.x - s.x);
            if (s.x < 160) s.target = 0;
            if (s.x > W - 160) s.target = Math.PI;
            if (s.y < 160) s.target = Math.PI / 2;
            if (s.y > H - 160) s.target = -Math.PI / 2;
          }
        }

        const turn = (isPlayer ? 3.4 : 2) * dt;
        s.angle += clamp(angleDifference(s.angle, s.target), -turn, turn);
        const boosting = isPlayer && (keys.Shift || keys[" "] || document.querySelector("#boost").dataset.down === "1") && s.mass > 60;
        const speed = s.speed * (boosting ? 1.55 : 1);
        if (boosting) s.mass -= dt * 12;

        s.x += Math.cos(s.angle) * speed * dt;
        s.y += Math.sin(s.angle) * speed * dt;
        s.body[0].x = s.x;
        s.body[0].y = s.y;

        for (let i = 1; i < s.body.length; i++) {
          const prev = s.body[i - 1], part = s.body[i];
          const dx = prev.x - part.x, dy = prev.y - part.y, d = Math.hypot(dx, dy);
          if (d > 13) {
            const amount = Math.min(d - 13, speed * dt * 1.4);
            part.x += dx / d * amount;
            part.y += dy / d * amount;
          }
        }

        if (s.x < 18 || s.y < 18 || s.x > W - 18 || s.y > H - 18) {
          if (isPlayer) endGame("You hit the arena wall.");
          else eliminate(s);
          return;
        }

        for (let i = 0; i < game.food.length; i++) {
          const food = game.food[i];
          if ((s.x - food.x) ** 2 + (s.y - food.y) ** 2 < 360) {
            s.mass += food.value * 3;
            if (s.body.length < Math.floor(s.mass / 10)) s.body.push({ ...s.body[s.body.length - 1] });
            game.food.splice(i, 1);
            addFood(food.x + random(-10, 10), food.y + random(-10, 10), food.color);
            break;
          }
        }
      }

      function eliminate(s) {
        if (!s.alive) return;
        s.alive = false;
        for (let i = 1; i < s.body.length; i += 2) {
          addFood(s.body[i].x, s.body[i].y, s.color, 2);
        }
      }

      function collisions() {
        const player = game.player;
        for (const bot of game.bots) {
          if (!bot.alive) continue;
          for (let i = 2; i < bot.body.length; i++) {
            if (distance(player, bot.body[i]) < 15) {
              endGame("You clashed with a rival snake.");
              return;
            }
          }
          for (let i = 3; i < player.body.length; i++) {
            if (distance(bot, player.body[i]) < 14) {
              eliminate(bot);
              game.kills++;
              break;
            }
          }
        }
        for (let i = 4; i < player.body.length; i++) {
          if (distance(player, player.body[i]) < 12) {
            endGame("You ran into yourself.");
            return;
          }
        }
      }

      function update(dt) {
        if (!game || game.state !== "playing") return;
        game.time += dt;
        updateSnake(game.player, dt, true);
        for (const bot of game.bots) updateSnake(bot, dt, false);
        collisions();
        if (game.state !== "playing") return;

        game.camera.x += (game.player.x - game.camera.x) * Math.min(1, dt * 4);
        game.camera.y += (game.player.y - game.camera.y) * Math.min(1, dt * 4);
        if (game.food.length < 170) addFood();

        document.querySelector("#score").textContent = Math.floor(game.player.mass);
        document.querySelector("#kills").textContent = game.kills;
        best = Math.max(best, Math.floor(game.player.mass));
        document.querySelector("#best").textContent = best;
        localStorage.setItem("snake-clash-best", String(best));
        updateLeaders();
      }

      function updateLeaders() {
        const snakes = [game.player, ...game.bots.filter(bot => bot.alive)]
          .sort((a, b) => b.mass - a.mass).slice(0, 5);
        document.querySelector("#leaders").innerHTML = snakes.map((s, i) =>
          `<li class="${s.player ? "you" : ""}"><span>${i + 1}. ${escapeText(s.name)}${s.player ? " ★" : ""}</span><b>${Math.floor(s.mass)}</b></li>`
        ).join("");
      }

      function escapeText(text) {
        return text.replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
      }

      function drawSnake(s) {
        if (!s.alive) return;
        ctx.save();
        ctx.lineWidth = 19;
        ctx.lineCap = "round";
        ctx.lineJoin = "round";
        ctx.strokeStyle = s.color;
        ctx.shadowColor = s.color;
        ctx.shadowBlur = 12;
        ctx.beginPath();
        ctx.moveTo(s.body[0].x, s.body[0].y);
        for (const part of s.body) ctx.lineTo(part.x, part.y);
        ctx.stroke();
        ctx.shadowBlur = 0;
        ctx.fillStyle = "#f3ffd9";
        ctx.beginPath();
        ctx.arc(s.x, s.y, 9, 0, TAU);
        ctx.fill();
        ctx.fillStyle = "#17232a";
        for (const side of [-1, 1]) {
          ctx.beginPath();
          ctx.arc(s.x + Math.cos(s.angle) * 4 - Math.sin(s.angle) * side * 4,
            s.y + Math.sin(s.angle) * 4 + Math.cos(s.angle) * side * 4, 2, 0, TAU);
          ctx.fill();
        }
        ctx.font = "bold 11px system-ui";
        ctx.textAlign = "center";
        ctx.fillStyle = "white";
        ctx.fillText(s.name, s.x, s.y - 17);
        ctx.restore();
      }

      function draw() {
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, width, height);
        ctx.fillStyle = "#081321";
        ctx.fillRect(0, 0, width, height);
        if (!game) return;

        ctx.save();
        ctx.translate(width / 2 - game.camera.x, height / 2 - game.camera.y);

        ctx.strokeStyle = "#31516a33";
        ctx.lineWidth = 1;
        for (let x = 0; x <= W; x += 44) {
          ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
        }
        for (let y = 0; y <= H; y += 44) {
          ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
        }

        ctx.strokeStyle = "#ff6372";
        ctx.lineWidth = 7;
        ctx.strokeRect(4, 4, W - 8, H - 8);

        for (const f of game.food) {
          ctx.fillStyle = f.color;
          ctx.shadowColor = f.color;
          ctx.shadowBlur = 10;
          ctx.beginPath();
          ctx.arc(f.x, f.y, 4 + Math.sin(game.time * 4 + f.phase), 0, TAU);
          ctx.fill();
        }
        ctx.shadowBlur = 0;
        for (const bot of game.bots) drawSnake(bot);
        drawSnake(game.player);
        ctx.restore();
      }

      function loop(time) {
        if (!game || game.state !== "playing") return;
        const dt = Math.min(.04, (time - last) / 1000 || 0);
        last = time;
        update(dt);
        draw();
        if (game && game.state === "playing") requestAnimationFrame(loop);
      }

      playButton.addEventListener("click", startGame);
      nameInput.addEventListener("keydown", e => { if (e.key === "Enter") startGame(); });

      addEventListener("keydown", e => {
        if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", " "].includes(e.key)) e.preventDefault();
        keys[e.key] = true;
      });
      addEventListener("keyup", e => { keys[e.key] = false; });

      canvas.addEventListener("pointermove", e => {
        if (!game || game.state !== "playing") return;
        const dx = e.clientX - width / 2, dy = e.clientY - height / 2;
        if (Math.hypot(dx, dy) > 5) game.player.target = Math.atan2(dy, dx);
      });
      canvas.addEventListener("pointerdown", e => {
        if (!game || game.state !== "playing") return;
        game.player.target = Math.atan2(e.clientY - height / 2, e.clientX - width / 2);
      });

      const boost = document.querySelector("#boost");
      boost.addEventListener("pointerdown", e => { e.preventDefault(); boost.dataset.down = "1"; });
      for (const event of ["pointerup", "pointercancel", "pointerleave"]) {
        boost.addEventListener(event, () => { boost.dataset.down = "0"; });
      }

      resize();
      draw();
    })();
  </script>
</body>
</html>
